APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
# Set true only when browser-facing HTTPS is guaranteed by the deployment.
APP_HTTPS=true
# Comma-separated exact IP addresses of trusted reverse proxies; leave empty unless required.
TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teamcode_hub
DB_USERNAME=teamcode_hub_app
DB_PASSWORD=
